# ===========================================================================
# Agentic Platform Backend - environment template
# Copy to .env and fill in real values.  ALL values can be overridden by
# real environment variables (which take precedence over this file).
# ===========================================================================

# --- application ------------------------------------------------------------
AGP_ENVIRONMENT=development           # development | test | production
# AGP_SECRET_KEY must be a strong random value; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGP_SECRET_KEY=change-me-generate-a-real-secret
AGP_LOG_LEVEL=INFO
AGP_LOG_JSON=false                    # true in production (structured JSON)

# --- database ---------------------------------------------------------------
# local development (SQLite):
AGP_DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# production (PostgreSQL):
# AGP_DATABASE_URL=postgresql+asyncpg://agp:password@postgres:5432/agp

# --- redis (optional; enables cross-process events + shared rate limits) ----
# AGP_REDIS_URL=redis://localhost:6379/0

# --- storage ----------------------------------------------------------------
AGP_STORAGE_BACKEND=local             # local | s3
AGP_STORAGE_LOCAL_ROOT=./data/storage
# S3-compatible (MinIO / AWS):
# AGP_S3_ENDPOINT_URL=http://localhost:9000
# AGP_S3_REGION=us-east-1
# AGP_S3_BUCKET=agentic-platform
# AGP_S3_ACCESS_KEY_ID=
# AGP_S3_SECRET_ACCESS_KEY=

# --- authentication ---------------------------------------------------------
AGP_ACCESS_TOKEN_TTL_SECONDS=1800
AGP_REFRESH_TOKEN_TTL_SECONDS=2592000
AGP_PASSWORD_MIN_LENGTH=10
# bootstrap an admin on first start (single-user private deployments):
# AGP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# AGP_BOOTSTRAP_ADMIN_PASSWORD=change-me-too

# --- security ---------------------------------------------------------------
# JSON list of allowed browser origins, e.g. ["https://app.example.com"]
AGP_CORS_ORIGINS=[]
AGP_TRUST_PROXY_HEADERS=false
AGP_RATE_LIMIT_AUTH_PER_MINUTE=10
AGP_RATE_LIMIT_DEFAULT_PER_MINUTE=600

# --- files ------------------------------------------------------------------
AGP_FILE_MAX_SIZE_BYTES=52428800      # 50 MiB
# AGP_FILE_MALWARE_SCAN_ENABLED=false # integration point (see docs/SECURITY.md)

# --- sandbox ----------------------------------------------------------------
AGP_SANDBOX_BACKEND=local            # local | docker (see docs/DEPLOYMENT_CLOUD.md)
AGP_SANDBOX_ROOT=./data/sandboxes
AGP_SANDBOX_DEFAULT_TIMEOUT_S=60
AGP_SANDBOX_MEMORY_LIMIT_MB=512
# JSON list of binaries the terminal tool may execute:
AGP_TERMINAL_ALLOWED_BINARIES=["ls","cat","head","tail","wc","grep","find","diff","echo","sort","uniq","python3","du","file","stat","mkdir"]

# --- model gateway ----------------------------------------------------------
AGP_DEFAULT_MODEL_NAME=test-echo
AGP_MODEL_REQUEST_TIMEOUT_S=120
# Saluki 27B integration boundary (enable AFTER verifying the runtime):
# AGP_SALUKI_ENDPOINT=http://saluki-host:8000/v1
# AGP_SALUKI_API_KEY=
# AGP_SALUKI_MODEL_ID=saluki-27b
# AGP_SALUKI_CONTEXT_WINDOW=32768

# --- conversation context assembly -------------------------------------------
AGP_CONTEXT_RECENT_MESSAGES=20
AGP_CONTEXT_MAX_CHARS=48000
AGP_CONTEXT_MEMORY_TOP_K=5
AGP_CHAT_MAX_TOOL_ROUNDS=3

# --- tasks / orchestration ----------------------------------------------------
AGP_TASK_MAX_STEPS=50
AGP_TASK_DEFAULT_DEADLINE_S=1800
AGP_TASK_MAX_PARALLEL_STEPS=3
AGP_TASK_STALE_AFTER_S=300
AGP_AUTO_APPROVE_PLANS=false          # keep false unless single-user trusted deployment

# --- background jobs / worker ---------------------------------------------------
AGP_WORKER_EMBEDDED=false             # true only for single-process local dev
AGP_WORKER_LEASE_S=120
AGP_WORKER_MAX_ATTEMPTS=5
AGP_JOB_RETRY_BACKOFF_BASE_S=5

# --- observability ---------------------------------------------------------------
AGP_METRICS_ENABLED=true
AGP_OTEL_ENABLED=false
# AGP_OTEL_ENDPOINT=http://otel-collector:4318/v1/traces
# AGP_OTEL_SERVICE_NAME=agentic-platform
