# Frontend environment template.
# Copy to `.env` and adjust. All values are build/dev-time Vite variables.

# API base URL. The default uses the Vite dev-server proxy (vite.config.ts),
# which forwards /api to the backend at http://127.0.0.1:8000 — same-origin,
# so no CORS configuration is required on the backend.
# In production you can either serve the built frontend behind a reverse
# proxy that forwards /api to the backend, or set an absolute URL here and
# configure the backend's AGP_CORS_ORIGINS to allow this origin.
VITE_API_BASE_URL=/api/v1

# WebSocket endpoint for realtime events (same-origin proxy by default).
VITE_WS_URL=/api/v1/ws

# Backend origin used by the dev-server proxy and `vite preview`.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
